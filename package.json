{
  "name": "easy-file-converter",
  "version": "1.0.0",
  "description": "A macOS desktop app that converts and combines .mov/.mp4 video files using FFmpeg, with selectable H.264/H.265 encoding and hardware acceleration.",
  "main": "main.js",
  "scripts": {
    "start": "NODE_ENV=production electron .",
    "dev": "NODE_ENV=development electron .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package-mac": "electron-packager . Easy-File-Converter --platform=darwin --arch=arm64 --asar.unpackDir=bin --overwrite"
  },
  "keywords": [
    "electron",
    "ffmpeg",
    "video-converter",
    "h265",
    "hevc",
    "macos"
  ],
  "author": "Felipe Slaughter-Quintero",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/felipe-sq/easy-file-converter.git"
  },
  "dependencies": {
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@electron/packager": "^19.1.0",
    "electron": "^41.1.1",
    "prettier": "^3.9.6"
  }
}
